<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The game folder, for Mono.Security.dll (the game's own copy makes the certificate). Same default as the plugin project. -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\TlsCertificate.cs" />
    <Compile Include="Program.cs" />
    <Reference Include="Mono.Security">
      <HintPath>$(GameDir)\NuclearOption_Data\Managed\Mono.Security.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
